{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mix",
  "colors": {
    "primary": "#6C5CE7",
    "light": "#A29BFE",
    "dark": "#5A4BD1"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "overview/introduction",
              "overview/getting-started",
              "overview/utility-first",
              "overview/comparison",
              "overview/best-practices",
              "overview/migration"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/styling",
              "guides/dynamic-styling",
              "guides/animations",
              "guides/design-tokens",
              "guides/directives",
              "guides/widget-modifiers"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/creating-a-widget",
              "tutorials/controlling-widget-state",
              "tutorials/theming",
              "tutorials/creating-context-variants"
            ]
          }
        ]
      },
      {
        "tab": "Widgets",
        "groups": [
          {
            "group": "StyleWidgets",
            "pages": [
              "widgets/overview",
              "widgets/box",
              "widgets/flexbox",
              "widgets/text",
              "widgets/icon",
              "widgets/image",
              "widgets/pressable",
              "widgets/stack"
            ]
          }
        ]
      },
      {
        "tab": "Ecosystem",
        "groups": [
          {
            "group": "Packages",
            "pages": [
              "ecosystem/mix-tailwinds"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/btwld/mix",
          "icon": "github"
        },
        {
          "anchor": "Pub.dev",
          "href": "https://pub.dev/packages/mix",
          "icon": "box-open"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/btwld/mix"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/btwld/mix"
    }
  }
}